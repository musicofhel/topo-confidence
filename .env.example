# topo-confidence environment variables
# Copy to .env and fill in. Most experiments only need a subset of these.

# --- Research-graph Neo4j (pathway-paper-finding knowledge graph) ---
# Used by research-graph/query.py, seed.py, bridge.py, generate_next_experiments.py.
# Started by `cd research-graph && docker compose up -d`.
NEO4J_BOLT_URL=bolt://localhost:7688
NEO4J_HTTP_URL=http://localhost:7475
NEO4J_USER=neo4j
NEO4J_PASSWORD=topo_graph_dev

# --- Link-forge bridge (separate Neo4j with full paper metadata) ---
# Optional: only required when resolving arxiv stubs to forgeScore + abstract.
# This is a separate database from research-graph above; do not collapse them.
LINK_FORGE_BOLT_URL=bolt://localhost:7687
LINK_FORGE_USER=neo4j
LINK_FORGE_PASSWORD=link_forge_dev

# --- Model + data ---
# Default extraction target. 7B comparisons exist for some pathways.
MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct
# Where MATH-500 / BBH / GSM8K splits live. Each pathway script documents what it needs.
MATH_500_PATH=
# HuggingFace transformers cache.
CACHE_DIR=

# --- RunPod (optional, only for pathway11_h100 H100 jobs) ---
# H100 SXM is the canonical extraction target. See ~/.claude/.../runpod-preferences.md.
RUNPOD_API_KEY=
